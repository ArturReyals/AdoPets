{
  "name": "adopets-root",
  "version": "1.0.0",
  "description": "Projeto principal com front e back integrados",
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "scripts": {
    "start:back": "cd adopets-backend && npm start",
    "start:front": "cd adopets-frontend && npm run dev",
    "dev": "concurrently \"npm run start:back\" \"npm run start:front\""
  }
}